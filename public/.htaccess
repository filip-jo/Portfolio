# Apache config for the static export on All-inkl, deployed to /portfolio-1/.
# Copied into out/ by `next build`. Rewrite rules here replace (not extend)
# any rules from the domain root's .htaccess, so HTTPS/www is enforced here too.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /portfolio-1/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and the www host.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.filipjo.com%{REQUEST_URI} [L,R=301]

  # Add a trailing slash to extensionless paths (matches trailingSlash: true).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ %{REQUEST_URI}/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Hashed build assets never change: cache for a year.
  <If "%{REQUEST_URI} =~ m#/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML must revalidate so new deploys show up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>
